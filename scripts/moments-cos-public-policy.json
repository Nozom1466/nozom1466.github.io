{
  "version": "2.0",
  "statement": [
    {
      "sid": "moments-public-index-list",
      "effect": "allow",
      "principal": {"qcs": ["qcs::cam::anyone:anyone"]},
      "action": ["name/cos:GetBucket"],
      "resource": ["qcs::cos:ap-shanghai:uid/1316371247:snapnote-test-1316371247/*"],
      "condition": {"string_equal": {"cos:prefix": "SnapNote_Sync%2Findex_shards%2F"}}
    },
    {
      "sid": "moments-public-files-read",
      "effect": "allow",
      "principal": {"qcs": ["qcs::cam::anyone:anyone"]},
      "action": ["name/cos:GetObject"],
      "resource": [
        "qcs::cos:ap-shanghai:uid/1316371247:snapnote-test-1316371247/SnapNote_Sync/index_shards/*",
        "qcs::cos:ap-shanghai:uid/1316371247:snapnote-test-1316371247/SnapNote_Sync/notes/*",
        "qcs::cos:ap-shanghai:uid/1316371247:snapnote-test-1316371247/SnapNote_Sync/resources/*"
      ]
    }
  ]
}
